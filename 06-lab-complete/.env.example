# Copy to .env.local for local Docker Compose overrides.
# Do not commit real .env or .env.local files.

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=false

# App
APP_NAME=Day 12 Production Agent
APP_VERSION=1.0.0

# LLM
OPENAI_API_KEY=
LLM_MODEL=mock-llm

# Security - change for production
AGENT_API_KEY=dev-key-change-me

# Rate and budget rubric requirements
RATE_LIMIT_PER_MINUTE=10
MONTHLY_BUDGET_USD=10.0

# Storage
REDIS_URL=redis://localhost:6379/0
HISTORY_TTL_SECONDS=2592000
MAX_HISTORY_MESSAGES=20

# CORS
ALLOWED_ORIGINS=*
